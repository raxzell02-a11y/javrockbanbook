listener_java = """package id.my.javrock.banbook;

import org.bukkit.Material;
import org.bukkit.entity.Item;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.EventPriority;
import org.bukkit.event.Listener;
import org.bukkit.event.block.CrafterCraftEvent;
import org.bukkit.event.entity.EntityPickupItemEvent;
import org.bukkit.event.entity.ProjectileLaunchEvent;
import org.bukkit.event.inventory.CraftItemEvent;
import org.bukkit.event.inventory.InventoryClickEvent;
import org.bukkit.event.inventory.InventoryDragEvent;
import org.bukkit.event.inventory.InventoryMoveItemEvent;
import org.bukkit.event.inventory.InventoryOpenEvent;
import org.bukkit.event.inventory.InventoryPickupItemEvent;
import org.bukkit.event.inventory.PrepareItemCraftEvent;
import org.bukkit.event.player.PlayerDropItemEvent;
import org.bukkit.event.player.PlayerEditBookEvent;
import org.bukkit.event.player.PlayerInteractEvent;
import org.bukkit.inventory.ItemStack;

public class BookBanListener implements Listener {

    private final JavrockBanBook plugin;

    public BookBanListener(JavrockBanBook plugin) {
        this.plugin = plugin;
    }

    private void notifyBlocked(Player player) {
        if (player != null && !plugin.getBlockedMessage().isEmpty()) {
            player.sendMessage(plugin.getBlockedMessage());
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST)
    public void onPrepareCraft(PrepareItemCraftEvent event) {
        if (event.getView().getPlayer() instanceof Player player && plugin.hasBypass(player)) {
            return;
        }
        ItemStack result = event.getInventory().getResult();
        if (JavrockBanBook.isBannedBook(result)) {
            event.getInventory().setResult(new ItemStack(Material.AIR));
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onCraftItem(CraftItemEvent event) {
        if (event.getWhoClicked() instanceof Player player && plugin.hasBypass(player)) {
            return;
        }
        if (JavrockBanBook.isBannedBook(event.getRecipe().getResult()) || JavrockBanBook.isBannedBook(event.getCurrentItem())) {
            event.setCancelled(true);
            event.getInventory().setResult(new ItemStack(Material.AIR));
            if (event.getWhoClicked() instanceof Player player) {
                notifyBlocked(player);
            }
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onCrafterCraft(CrafterCraftEvent event) {
        if (JavrockBanBook.isBannedBook(event.getResult())) {
            event.setCancelled(true);
            event.setResult(new ItemStack(Material.AIR));
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onPlayerDrop(PlayerDropItemEvent event) {
        if (plugin.hasBypass(event.getPlayer())) {
            return;
        }
        Item dropEntity = event.getItemDrop();
        if (JavrockBanBook.isBannedBook(dropEntity.getItemStack())) {
            dropEntity.remove();
            notifyBlocked(event.getPlayer());
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onEntityPickup(EntityPickupItemEvent event) {
        if (event.getEntity() instanceof Player player && plugin.hasBypass(player)) {
            return;
        }
        if (JavrockBanBook.isBannedBook(event.getItem().getItemStack())) {
            event.setCancelled(true);
            event.getItem().remove();
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onHopperPickup(InventoryPickupItemEvent event) {
        if (JavrockBanBook.isBannedBook(event.getItem().getItemStack())) {
            event.setCancelled(true);
            event.getItem().remove();
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onInventoryMove(InventoryMoveItemEvent event) {
        if (JavrockBanBook.isBannedBook(event.getItem())) {
            event.setCancelled(true);
            event.setItem(new ItemStack(Material.AIR));
            JavrockBanBook.purgeBannedBooks(event.getSource());
            JavrockBanBook.purgeBannedBooks(event.getDestination());
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onInventoryClick(InventoryClickEvent event) {
        if (event.getWhoClicked() instanceof Player player && plugin.hasBypass(player)) {
            return;
        }

        boolean cursorBanned = JavrockBanBook.isBannedBook(event.getCursor());
        boolean currentBanned = JavrockBanBook.isBannedBook(event.getCurrentItem());
        ItemStack hotbarItem = event.getHotbarButton() >= 0
                ? event.getWhoClicked().getInventory().getItem(event.getHotbarButton())
                : null;
        boolean hotbarBanned = JavrockBanBook.isBannedBook(hotbarItem);

        if (cursorBanned || currentBanned || hotbarBanned) {
            event.setCancelled(true);
            if (cursorBanned) {
                event.getWhoClicked().setItemOnCursor(null);
            }
            if (currentBanned) {
                event.setCurrentItem(null);
            }
            if (hotbarBanned && event.getHotbarButton() >= 0) {
                event.getWhoClicked().getInventory().setItem(event.getHotbarButton(), null);
            }
            if (event.getWhoClicked() instanceof Player player) {
                notifyBlocked(player);
            }
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onInventoryDrag(InventoryDragEvent event) {
        if (event.getWhoClicked() instanceof Player player && plugin.hasBypass(player)) {
            return;
        }

        boolean hasBanned = JavrockBanBook.isBannedBook(event.getOldCursor()) || JavrockBanBook.isBannedBook(event.getCursor());
        if (!hasBanned) {
            for (ItemStack stack : event.getNewItems().values()) {
                if (JavrockBanBook.isBannedBook(stack)) {
                    hasBanned = true;
                    break;
                }
            }
        }
        if (hasBanned) {
            event.setCancelled(true);
            event.getWhoClicked().setItemOnCursor(null);
            if (event.getWhoClicked() instanceof Player player) {
                notifyBlocked(player);
            }
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onInventoryOpen(InventoryOpenEvent event) {
        if (event.getPlayer() instanceof Player player && plugin.hasBypass(player)) {
            return;
        }
        JavrockBanBook.purgeBannedBooks(event.getInventory());
        JavrockBanBook.purgeBannedBooks(event.getPlayer().getInventory());
        JavrockBanBook.purgeBannedBooks(event.getPlayer().getEnderChest());
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onPlayerInteract(PlayerInteractEvent event) {
        if (plugin.hasBypass(event.getPlayer())) {
            return;
        }
        if (JavrockBanBook.isBannedBook(event.getItem())) {
            event.setCancelled(true);
            event.getPlayer().getInventory().remove(event.getItem());
            notifyBlocked(event.getPlayer());
        }
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onEditBook(PlayerEditBookEvent event) {
        if (plugin.hasBypass(event.getPlayer())) {
            return;
        }
        event.setCancelled(true);
        notifyBlocked(event.getPlayer());
    }

    @EventHandler(priority = EventPriority.HIGHEST, ignoreCancelled = true)
    public void onProjectileLaunch(ProjectileLaunchEvent event) {
        if (event.getEntity().getShooter() instanceof Player player) {
            if (plugin.hasBypass(player)) {
                return;
            }
            ItemStack mainHand = player.getInventory().getItemInMainHand();
            ItemStack offHand = player.getInventory().getItemInOffHand();
            if (JavrockBanBook.isBannedBook(mainHand) || JavrockBanBook.isBannedBook(offHand)) {
                event.setCancelled(true);
            }
        }
    }
}
