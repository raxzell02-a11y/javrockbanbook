main_java = """package id.my.javrock.banbook;

import org.bukkit.Bukkit;
import org.bukkit.ChatColor;
import org.bukkit.Material;
import org.bukkit.entity.Player;
import org.bukkit.inventory.Inventory;
import org.bukkit.inventory.ItemStack;
import org.bukkit.plugin.java.JavaPlugin;

import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class JavrockBanBook extends JavaPlugin {

    private static final Pattern HEX_PATTERN = Pattern.compile("&#([A-Fa-f0-9]{6})");

    private String blockedMessage;
    private boolean allowBypass;
    private long purgeIntervalSeconds;

    @Override
    public void onEnable() {
        saveDefaultConfig();
        loadPluginConfig();

        getServer().getPluginManager().registerEvents(new BookBanListener(this), this);

        long periodTicks = Math.max(1L, purgeIntervalSeconds) * 20L;
        Bukkit.getScheduler().runTaskTimer(this, () -> {
            for (Player player : Bukkit.getOnlinePlayers()) {
                if (hasBypass(player)) {
                    continue;
                }
                purgeBannedBooks(player.getInventory());
                purgeBannedBooks(player.getEnderChest());
                purgeBannedBooks(player.getOpenInventory().getTopInventory());
            }
        }, periodTicks, periodTicks);

        getLogger().info("JavrockBanBook aktif! WRITABLE_BOOK dan WRITTEN_BOOK diblokir total.");
    }

    public void loadPluginConfig() {
        String rawMessage = getConfig().getString(
                "blocked-message",
                "&cItem &fBook and Quill &cdan &fWritten Book &cdilarang keras di server ini!"
        );
        this.blockedMessage = colorize(rawMessage);
        this.allowBypass = getConfig().getBoolean("allow-bypass", true);
        this.purgeIntervalSeconds = getConfig().getLong("purge-interval-seconds", 1L);
    }

    public String getBlockedMessage() {
        return blockedMessage;
    }

    public boolean hasBypass(Player player) {
        return player != null && allowBypass && player.hasPermission("javrockbanbook.bypass");
    }

    public static String colorize(String text) {
        if (text == null) {
            return "";
        }
        Matcher matcher = HEX_PATTERN.matcher(text);
        StringBuffer buffer = new StringBuffer();
        while (matcher.find()) {
            String hex = matcher.group(1);
            StringBuilder replacement = new StringBuilder("§x");
            for (char c : hex.toCharArray()) {
                replacement.append('§').append(c);
            }
            matcher.appendReplacement(buffer, Matcher.quoteReplacement(replacement.toString()));
        }
        matcher.appendTail(buffer);
        return ChatColor.translateAlternateColorCodes('&', buffer.toString());
    }

    public static boolean isBannedBook(ItemStack item) {
        if (item == null || item.getType().isAir()) {
            return false;
        }
        Material type = item.getType();
        return type == Material.WRITABLE_BOOK || type == Material.WRITTEN_BOOK;
    }

    public static void purgeBannedBooks(Inventory inventory) {
        if (inventory == null) {
            return;
        }
        for (int i = 0; i < inventory.getSize(); i++) {
            ItemStack item = inventory.getItem(i);
            if (isBannedBook(item)) {
                inventory.setItem(i, null);
            }
        }
    }
}
